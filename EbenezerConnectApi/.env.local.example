# Local development only. Copy to .env.local and fill with your real remote MySQL values.
ConnectionStrings__DefaultConnection=server=YOUR_REMOTE_MYSQL_HOST;port=3306;database=YOUR_DB_NAME;uid=YOUR_DB_USER;pwd=YOUR_DB_PASSWORD

Jwt__Key=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS_______
Jwt__Issuer=EbenezerConnectApi
Jwt__Audience=EbenezerConnectApp

EmailSettings__From=YOUR_SMTP_EMAIL
EmailSettings__Password=YOUR_SMTP_PASSWORD

AppSettings__BaseUrl=http://localhost:5000
Cors__AllowedOrigins=http://localhost:4200;http://localhost:3000

SeedAdmin__Enabled=false
SeedAdmin__Name=Admin
SeedAdmin__Email=admin@example.com
SeedAdmin__Password=CHANGE_ME_STRONG_PASSWORD
SeedAdmin__Cpf=00000000000