{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: ConnectionStrings__DefaultConnection"
  },
  "Jwt": {
    "Key": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: Jwt__Key",
    "Issuer": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: Jwt__Issuer",
    "Audience": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: Jwt__Audience"
  },
  "EmailSettings": {
    "From": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: EmailSettings__From",
    "Password": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: EmailSettings__Password"
  },
  "AppSettings": {
    "BaseUrl": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: AppSettings__BaseUrl"
  },
  "Cors": {
    "AllowedOrigins": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: Cors__AllowedOrigins"
  },
  "SeedAdmin": {
    "Enabled": false,
    "Name": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: SeedAdmin__Name",
    "Email": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: SeedAdmin__Email",
    "Password": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: SeedAdmin__Password",
    "Cpf": "OVERRIDE_VIA_ENVIRONMENT_VARIABLE: SeedAdmin__Cpf"
  }
}

