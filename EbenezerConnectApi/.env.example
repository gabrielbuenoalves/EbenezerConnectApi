# External MySQL (this DB already exists and is NOT created by compose)
ConnectionStrings__DefaultConnection=server=YOUR_DB_HOST;port=3306;database=YOUR_DB_NAME;uid=YOUR_DB_USER;pwd=YOUR_DB_PASSWORD

# JWT
Jwt__Key=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS_______
Jwt__Issuer=EbenezerConnectApi
Jwt__Audience=EbenezerConnectApp

# SMTP
EmailSettings__From=YOUR_SMTP_EMAIL
EmailSettings__Password=YOUR_SMTP_PASSWORD

# Public base URL for links generated by backend (no trailing slash)
AppSettings__BaseUrl=https://api.your-domain.com

# CORS: semi-colon separated list of allowed origins
Cors__AllowedOrigins=http://localhost:4200;http://localhost:3000;https://your-domain.com

# Seed Admin: configure to create an initial admin user on first run
SeedAdmin__Enabled=false
SeedAdmin__Name=Admin
SeedAdmin__Email=admin@example.com
SeedAdmin__Password=CHANGE_ME_STRONG_PASSWORD
SeedAdmin__Cpf=00000000000
